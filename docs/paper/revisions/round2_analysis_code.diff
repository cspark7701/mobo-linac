+    pd.DataFrame({"emit_x_um_rad": [1.0, 2.0], "emit_y_um_rad": [2.0, 1.0],
+                  "sigma_energy_MeV": [0.5, 0.5]}).to_csv(tmp_path / "c03_empirical_reference.csv", index=False)
+    pipelines = [{"method": m, "group": g, "evaluations": 160, "front_size_unique": 3,
