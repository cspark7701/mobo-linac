+def test_dominance_requires_one_strict_improvement(analysis):
+    assert analysis.dominates(np.array([1, 1, 1]), np.array([1, 2, 1]))
+    assert not analysis.dominates(np.array([1, 1, 1]), np.array([1, 1, 1]))
