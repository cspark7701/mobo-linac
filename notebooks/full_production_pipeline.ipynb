    "from scripts.run_robustness_analysis import run_robustness_analysis\n",
    "\n",
    "robust_df = run_robustness_analysis(\n",
    "    pareto_df=p3_pareto_df,\n",
    "    config=config,\n",
    "    output_dir=analysis_dir / \"robustness\",\n",
    "    num_workers=num_workers\n",
    ")\n",
    "\n",
    "print(\"Robustness Evaluation Summary:\")\n",
    "display(robust_df)"
   ]
